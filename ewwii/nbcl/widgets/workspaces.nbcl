Poll "active_workspace" {
  initial = "1"
  interval = "1000ms"
	cmd = "bash ~/.config/ewwii/scripts/bash.sh get workspace-active"
}

component Workspace() {
  Box {
    class = "workspaces"
    halign = "center"
    valign = "center"
    space_evenly = false
    for w in 1..5 {
      # w = count.to_string()
      Button {
        class = global("active_workspace").template("workspace-icon{active_workspace == '" + w.to_string() + "'? ' active' : ''}")
        label = ""
        tooltip = "Workspace " + w.to_string()
        valign = "center"
        onclick = "bash ~/.config/ewwii/scripts/bash.sh run go-to " + w.to_string()
      }
    }
  }
}
